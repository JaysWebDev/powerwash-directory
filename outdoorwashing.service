[Unit]
Description=OutdoorWashing.com — Next.js App
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=j
WorkingDirectory=/home/j/_DEV/powerwash-directory
ExecStart=/usr/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5

Environment=NODE_ENV=production
Environment=PORT=3031
Environment=HOSTNAME=127.0.0.1

# Supabase — fill these in before enabling
EnvironmentFile=-/home/j/_DEV/powerwash-directory/.env.local

StandardOutput=journal
StandardError=journal
SyslogIdentifier=outdoorwashing

[Install]
WantedBy=multi-user.target
